#AWS CONFIGURATION
ACCESS_KEY = "xxxxxx"
SECRET_ACCESS_KEY = "xxxxxxxx"
AWS_REGION = "us-east-1"
S3_BUCKET = "atlas-enterprise"

#BEDROCK CONFIGURATION
BEDROCK_EMBED_MODEL = "amazon.titan-embed-text-v2:0"
BEDROCK_CHAT_MODEL = "amazon.nova-lite-text-v1:0"
EMBED_DIM = 1024

#PINECONE CONFIGURATION
PINECONE_API_KEY = "pcsk_xxxxx"
PINECONE_INDEX_HOST = "atlas-enterprise-ai-index"   
PINECONE_CLOUD = aws
PINECONE_REGION = "us-east-1"
PINECONE_READY_TIMEOUT = 180

#POSTGRESQL CONFIGURATION
DATABASE_URL = postgresql://atlas_user:@atlas_password/database?sslmode=require

#RIUS CONFIGURATION
RIUS_API_KEY = "ri_xxxxxx"
RIUS_SERVICE_NAME = "atlas-ai-enterprise"-
RIUS_DISABLED = false
RIUS_CAPTURE_CONTENT = false